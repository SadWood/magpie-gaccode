    "opencode-plugin",
    "magpie",
    "gaccode",
    "claude",
    "codex",
    "gemini",
    "provider",
    "magpie-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SadWood/magpie-gaccode.git"
  },
  "magpie": {
